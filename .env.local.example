# Google Workspace OAuth2 (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_BASE_URL="http://localhost:3000"

# Google Gemini API (Google AI Studio)
GEMINI_API_KEY=""

# Local AES-256-GCM encryption key (32+ random chars or 64 hex chars; auto-fallback .data/master.key if omitted in dev)
APP_ENCRYPTION_KEY=""

# Strict Sandbox Isolation (keep true for pilot [PILOTE - 326027])
SANDBOX_MODE="true"

# Prisma / SQLite local
DATABASE_URL="file:./dev.db"
