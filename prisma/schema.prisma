generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueEnc  String
  isSecret  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleConnection {
  id              String   @id @default(cuid())
  userId          String?
  userEmail       String   @unique
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime
  scope           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String
  jobTitle            String?
  role                String   @default("MEMBER")
  avatarId            String   @default("gamer-cat")
  avatarBg            String   @default("#FDE68A")
  lastActiveProjectId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  googleConnections GoogleConnection[]
  ownedProjects     Project[]          @relation("ProjectOwner")
  memberships       ProjectMember[]
  uploadedInvoices  Invoice[]          @relation("InvoiceUploader")
  assignedTasks     RetroTask[]        @relation("TaskOwnerUser")
  notificationReads NotificationRead[]

  @@index([role])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("VIEWER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model CategoryTemplate {
  id                 String   @id @default(cuid())
  category           String   @unique
  budgetLinesJson    String   @default("[]")
  retroTasksJson     String   @default("[]")
  weeklyTemplateJson String   @default("{}")
  updatedAt          DateTime @updatedAt
}

model Project {
  id                        String    @id @default(cuid())
  codeProjet                String
  client                    String
  nomJeu                    String
  category                  String    @default("JEU")
  ownerId                   String?
  isArchived                Boolean   @default(false)
  archivedAt                DateTime?
  archivedById              String?
  isSandbox                 Boolean   @default(true)
  nextInvoiceSeq            Int       @default(0)
  driveInternalRootId       String?
  driveExternalRootId       String?
  budgetSheetId             String?
  retroplanningSheetId      String?
  reportingSheetId          String?
  weeklyTemplateSlidesId    String?
  reportingTemplateSlidesId String?
  gmailLabelId              String?
  gmailMatchRulesJson       String    @default("{}")
  calendarId                String?
  brandKitJson              String    @default("{}")
  talentsJson               String    @default("[]")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  owner             User?             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members           ProjectMember[]
  driveNodes        DriveNode[]
  syncStatuses      SyncStatus[]
  budgetLines       BudgetLine[]
  quotes            Quote[]
  invoices          Invoice[]
  retroTasks        RetroTask[]
  retroProposals    RetroProposal[]
  retroSnapshots    RetroSnapshot[]
  calendarRules     CalendarRule[]
  calendarEvents    CalendarEvent[]
  weeklyReports     WeeklyReport[]
  reportingRawFiles ReportingRawFile[]
  fortniteMetrics   FortniteMetric[]
  influenceMetrics  InfluenceMetric[]
  verbatims         Verbatim[]
  meetingNotes      MeetingNote[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@unique([codeProjet, client, nomJeu])
  @@index([codeProjet])
  @@index([ownerId])
  @@index([isArchived])
}

model DriveNode {
  id                 String    @id @default(cuid())
  projectId          String
  code               String
  name               String
  driveFileId        String?
  parentNodeId       String?
  isFolder           Boolean   @default(true)
  mimeType           String?
  isExtEligible      Boolean   @default(false)
  extMirrorFileId    String?
  lastSyncedAt       DateTime?
  internalModifiedAt DateTime?
  contentHash        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     DriveNode?  @relation("DriveTree", fields: [parentNodeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children   DriveNode[] @relation("DriveTree")
  syncStatus SyncStatus?

  @@index([projectId, code])
  @@index([projectId, driveFileId])
  @@index([parentNodeId])
  @@index([projectId, isFolder])
}

model SyncStatus {
  id                    String    @id @default(cuid())
  projectId             String
  driveNodeId           String    @unique
  validationStatus      String    @default("BROUILLON_INTERNE")
  driftDetected         Boolean   @default(false)
  lastExtSyncAt         DateTime?
  allowPermanentExtSync Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  driveNode DriveNode @relation(fields: [driveNodeId], references: [id], onDelete: Cascade)

  @@index([projectId, validationStatus])
  @@index([projectId, driftDetected])
}

model BudgetLine {
  id                 String   @id @default(cuid())
  projectId          String
  category           String
  objet              String
  realisePar         String?
  expenseType        String   @default("Externe")
  saleQty            Float    @default(1)
  saleDays           Float    @default(1)
  saleUnitPrice      Float    @default(0)
  saleTotalHt        Float    @default(0)
  preOpUnitCost      Float    @default(0)
  preOpTotalHt       Float    @default(0)
  postOpQty          Float    @default(0)
  postOpDays         Float    @default(0)
  postOpUnitCost     Float    @default(0)
  postOpTotalHt      Float    @default(0)
  sheetRowIndex      Int?
  invoiceNumbersNote String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotes   Quote[]
  invoices Invoice[]

  @@index([projectId])
}

model Quote {
  id               String   @id @default(cuid())
  projectId        String
  budgetLineId     String?
  quoteNumber      String
  vendorName       String
  description      String?
  issueDate        String?
  validUntil       String?
  amountHt         Float    @default(0)
  tvaAmount        Float    @default(0)
  amountTtc        Float    @default(0)
  status           String   @default("EN_ATTENTE")
  originalFilename String?
  localPdfPath     String?
  pdfData          Bytes?
  driveFileId      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  invoices   Invoice[]

  @@index([projectId, status])
  @@index([budgetLineId])
}

model Invoice {
  id                 String   @id @default(cuid())
  projectId          String
  uploadedById       String?
  budgetLineId       String?
  quoteId            String?
  gmailMessageId     String?
  originalFilename   String
  renamedFilename    String?
  driveFileId        String?
  vendorName            String?
  invoiceNumber         String?
  supplierInvoiceNumber String?
  invoiceDate           String?
  amountHt              Float    @default(0)
  tvaAmount             Float    @default(0)
  amountTtc             Float    @default(0)
  invoiceType           String   @default("UNIQUE")
  prestationLabel       String?
  detectedCodeProjet    String?
  projectCodesJson      String   @default("[]")
  vigilanceDriveFileId  String?
  vigilanceFilename     String?
  vigilancePdfData      Bytes?
  pdfData               Bytes?
  cpConflict            Boolean  @default(false)
  status                String   @default("PENDING_VALIDATION")
  pennylaneDraftId      String?
  extractedJson         String   @default("{}")
  stepDriveDone         Boolean  @default(false)
  stepSheetDone         Boolean  @default(false)
  stepGmailDone         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation("InvoiceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  quote      Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([projectId, uploadedById, status])
  @@index([projectId, cpConflict])
  @@index([projectId, invoiceNumber])
  @@index([projectId, supplierInvoiceNumber])
  @@index([gmailMessageId])
  @@index([quoteId])
  @@index([budgetLineId])
  @@index([projectId, createdAt])
}

model Vendor {
  id                   String    @id @default(cuid())
  name                 String
  normalizedName       String    @unique
  email                String?
  siret                String?
  category             String?
  vigilanceDriveFileId String?
  vigilanceFilename    String?
  vigilanceIssuedAt    DateTime?
  vigilanceExpiresAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model RetroTask {
  id            String    @id @default(cuid())
  projectId     String
  phase         String
  etape         String?
  tache         String
  owner         String?
  ownerUserId   String?
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("A_FAIRE")
  sheetRowIndex Int?
  isMilestone   Boolean   @default(false)
  milestoneType String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerUser      User?           @relation("TaskOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  proposals      RetroProposal[]
  calendarEvents CalendarEvent[]

  @@index([projectId])
  @@index([projectId, status, endDate])
  @@index([ownerUserId, status, endDate])
  @@index([projectId, sheetRowIndex])
}

model RetroProposal {
  id                String    @id @default(cuid())
  projectId         String
  retroTaskId       String?
  sourceType        String
  sourceRef         String?
  summary           String
  evidenceQuote     String?
  proposedStatus    String?
  proposedStartDate DateTime?
  proposedEndDate   DateTime?
  deltaDays         Int       @default(0)
  confidence        Float     @default(0.8)
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retroTask RetroTask? @relation(fields: [retroTaskId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([retroTaskId])
}

model RetroSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  snapshotDate DateTime
  driveFileId  String?
  tasksJson    String
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, snapshotDate])
}

model CalendarRule {
  id                  String   @id @default(cuid())
  projectId           String
  milestoneType       String
  offsetDays          Int
  titleTemplate       String
  descriptionTemplate String?
  createdAt           DateTime @default(now())

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]

  @@index([projectId, milestoneType])
}

model CalendarEvent {
  id             String   @id @default(cuid())
  projectId      String
  retroTaskId    String?
  calendarRuleId String?
  googleEventId  String?
  title          String
  startAt        DateTime
  endAt          DateTime
  status         String   @default("SCHEDULED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retroTask    RetroTask?    @relation(fields: [retroTaskId], references: [id], onDelete: Cascade)
  calendarRule CalendarRule? @relation(fields: [calendarRuleId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, retroTaskId, status])
  @@index([projectId, startAt])
  @@index([googleEventId])
}

model WeeklyReport {
  id                  String   @id @default(cuid())
  projectId           String
  weekStart           DateTime
  weekEnd             DateTime
  title               String
  slidesFileId        String?
  gmailDraftId        String?
  collectedTasksJson  String   @default("[]")
  visualsDriveIdsJson String   @default("[]")
  nextStepsClientJson String   @default("[]")
  nextStepsGoJson     String   @default("[]")
  status              String   @default("DRAFT")
  createdAt           DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, weekEnd])
}

model ReportingRawFile {
  id               String   @id @default(cuid())
  projectId        String
  sourceType       String
  talentName       String?
  platform         String?
  driveFileId      String?
  localPreviewPath String?
  processed        Boolean  @default(false)
  createdAt        DateTime @default(now())

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fortniteMetrics  FortniteMetric[]
  influenceMetrics InfluenceMetric[]

  @@index([projectId, sourceType])
}

model FortniteMetric {
  id             String   @id @default(cuid())
  projectId      String
  rawFileId      String?
  date           String
  uniquePlayers  Int      @default(0)
  sessions       Int      @default(0)
  avgPlaytimeSec Float    @default(0)
  retentionD1    Float?
  peakConcurrent Int      @default(0)
  createdAt      DateTime @default(now())

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rawFile ReportingRawFile? @relation(fields: [rawFileId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
}

model InfluenceMetric {
  id              String    @id @default(cuid())
  projectId       String
  rawFileId       String?
  talentName      String
  platform        String
  contentUrl      String?
  sparkCode       String?
  publishedAt     DateTime?
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  reposts         Int?
  saves           Int?
  engagementRate  Float?
  confidenceJson  String?
  verifiedByHuman Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rawFile ReportingRawFile? @relation(fields: [rawFileId], references: [id], onDelete: SetNull)

  @@index([projectId, talentName, platform])
}

model Verbatim {
  id                String   @id @default(cuid())
  projectId         String
  authorHandle      String
  platform          String
  talentName        String?
  quote             String
  likesCount        Int      @default(0)
  selectedForSlides Boolean  @default(false)
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AuditLog {
  id          String   @id @default(cuid())
  projectId   String?
  actor       String
  action      String
  targetType  String
  targetId    String?
  detailsJson String   @default("{}")
  createdAt   DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model MeetingNote {
  id                         String   @id @default(cuid())
  projectId                  String
  source                     String   @default("KRISP_WEBHOOK")
  externalId                 String?
  title                      String
  meetingDate                DateTime
  durationMinutes            Int?
  participantsJson           String   @default("[]")
  summary                    String
  keyDecisionsJson           String   @default("[]")
  actionItemsJson            String   @default("[]")
  convertedActionIndexesJson String   @default("[]")
  rawTranscript              String?
  driveFileId                String?
  driveFileName              String?
  driveWebViewLink           String?
  driveFolderCode            String   @default("002.3")
  status                     String   @default("SAVED_TO_DRIVE")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, meetingDate])
  @@index([externalId])
  @@index([projectId, externalId])
}

model Notification {
  id        String   @id @default(cuid())
  projectId String?
  type      String   @default("KRISP_CR")
  title     String
  message   String
  actionUrl String?
  driveUrl  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reads   NotificationRead[]

  @@index([read, createdAt])
  @@index([projectId, createdAt])
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model BackupSnapshot {
  id            String   @id @default(cuid())
  trigger       String   @default("MANUAL")
  executionId   String?  @unique
  status        String   @default("COMPLETED")
  projectsCount Int      @default(0)
  usersCount    Int      @default(0)
  invoicesCount Int      @default(0)
  quotesCount   Int      @default(0)
  sizeBytes     Int      @default(0)
  payloadJson   String
  createdBy     String   @default("system")
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
