# Base de données (SQLite en local, PostgreSQL en équipe)
DATABASE_URL="file:./dev.db"

# URL publique de l'application
APP_BASE_URL="http://localhost:3000"

# Clé de chiffrement AES-256-GCM (64 caractères hexadécimaux en production)
APP_ENCRYPTION_KEY=""

# Identifiants Google Workspace OAuth2 (ou configurables depuis /settings)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Clé API Gemini (ou configurable depuis /settings)
GEMINI_API_KEY=""
